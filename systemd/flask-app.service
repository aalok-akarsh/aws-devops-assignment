[Unit]
Description=Flask Application
After=network.target

[Service]
User=ubuntu
Group=ubuntu

WorkingDirectory=/home/ubuntu/aws-devops-assignment

Environment="PATH=/home/ubuntu/aws-devops-assignment/venv/bin"

ExecStart=/home/ubuntu/aws-devops-assignment/venv/bin/python app/app.py

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
