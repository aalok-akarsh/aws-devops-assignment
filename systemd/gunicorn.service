[Unit]
Description=Gunicorn service for Flask application
After=network.target

[Service]
User=ubuntu
Group=ubuntu

WorkingDirectory=/home/ubuntu/aws-devops-assignment

Environment="PATH=/home/ubuntu/aws-devops-assignment/venv/bin"

ExecStart=/home/ubuntu/aws-devops-assignment/venv/bin/gunicorn \
          --workers 2 \
          --bind 127.0.0.1:8000 \
          app.app:app

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
