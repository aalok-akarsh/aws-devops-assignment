{
  "agent": {

    "metrics_collection_interval": 60,
     "run_as_user": "root"
  },

  "metrics": {

    "namespace": "AWSDevOpsAssignment",

    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },

    "metrics_collected": {

      "cpu": {
        "measurement": [
          "cpu_usage_idle",
          "cpu_usage_user",
          "cpu_usage_system"
        ],
        "totalcpu": true
      },

      "disk": {
        "measurement": [
          "used_percent"
        ],
        "resources": [
          "/"
        ]
      },

      "mem": {
        "measurement": [
          "mem_used_percent"
        ]
      },

      "swap": {
        "measurement": [
          "swap_used_percent"
        ]
      }

    }
  },

  "logs": {

    "logs_collected": {

      "files": {

        "collect_list": [

          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "nginx-access",
            "log_stream_name": "{instance_id}"
          },

          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "nginx-error",
            "log_stream_name": "{instance_id}"
          },

          {
            "file_path": "/var/log/syslog",
            "log_group_name": "system-log",
            "log_stream_name": "{instance_id}"
          }

        ]
      }
    }
  }
}
